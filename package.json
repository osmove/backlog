{
  "name": "backlog-monorepo",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "build": "pnpm --filter @backlog/board-ui build && pnpm --filter backlog build",
    "build:tsc": "tsc -b",
    "clean": "find . -name '*.tsbuildinfo' -delete && find packages -name dist -type d -prune -exec rm -rf {} +",
    "dev": "pnpm --filter backlog dev",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "pack:check": "cd packages/cli && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
