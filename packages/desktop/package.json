{
  "name": "@backlog/desktop",
  "version": "1.4.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Backlog desktop app (Electron) — embeds the local Hono server and kanban UI in a native window.",
  "homepage": "https://backlog.so",
  "author": {
    "name": "Osmove",
    "email": "hello@backlog.so",
    "url": "https://backlog.so"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osmove/backlog.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "tsup",
    "dev": "tsup && NODE_ENV=development electron dist/main.mjs",
    "start": "electron dist/main.mjs",
    "dist:mac": "pnpm build && electron-builder --mac --x64 --arm64",
    "dist:linux": "pnpm build && electron-builder --linux --x64 --arm64",
    "dist:win": "pnpm build && electron-builder --win --x64 --arm64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@backlog/claims": "workspace:*",
    "@backlog/config": "workspace:*",
    "@backlog/connectors": "workspace:*",
    "@backlog/core": "workspace:*",
    "@backlog/git": "workspace:*",
    "@backlog/schemas": "workspace:*",
    "@backlog/server": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@iarna/toml": "^2.2.5",
    "electron-updater": "^6.8.3",
    "execa": "^9.6.0",
    "hono": "^4.6.13",
    "picomatch": "^4.0.2",
    "yaml": "^2.8.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
